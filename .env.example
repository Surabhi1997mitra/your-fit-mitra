# Your Fit Mitra — environment variables (NAMES ONLY)
#
# Copy this file to .env.local for local development and fill in TEST values.
# .env.local is git-ignored. Never commit real values, and never paste them
# into chat, issues or pull requests.
#
# Anything starting with NEXT_PUBLIC_ is sent to the browser. Secrets must
# never use that prefix.
#
# Production values live only in Vercel → Settings → Environment Variables
# (Production scope, marked Sensitive). Preview and local use test values.

# ── Site (Phase 1) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in E.164 format without "+", e.g. 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Supabase (Phase 3) ─────────────────────────────────────────
# Dev project (yfm-dev) for local + Preview; prod project (yfm-prod) for Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses Row-Level Security.
SUPABASE_SECRET_KEY=

# ── Razorpay (Phases 4–5) ──────────────────────────────────────
# Local + Preview: rzp_test_… keys only. Live keys go in Vercel Production only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SERVER ONLY.
RAZORPAY_KEY_SECRET=
# SERVER ONLY. Set when the webhook is created in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ── Scheduled jobs (Phase 5) ───────────────────────────────────
# SERVER ONLY. Random string, 32+ characters.
CRON_SECRET=
